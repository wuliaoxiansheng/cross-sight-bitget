# Shared
NODE_ENV=development

# API
PORT=4000
DATABASE_URL=postgresql://cross_sight:cross_sight@localhost:5432/cross_sight?schema=public
BITGET_BASE_URL=https://api.bitget.com
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_DEX=xyz
CORS_ORIGIN=http://localhost:3000
DEFAULT_NOTIONAL_USD=5000
OPEN_EDGE_THRESHOLD=0.003
FUNDING_PERIODS_TO_PRICE=1
# Optional: protect heavy manual endpoints (refresh/live-all/preview).
# Leave empty for open local dev; set a secret to require an x-api-token header.
API_TOKEN=
# Min spacing (ms) between on-demand full scans triggered over HTTP.
LIVE_SCAN_MIN_INTERVAL_MS=10000
# Optional: Feishu bot webhook. Leave empty to disable OPEN opportunity alerts.
FEISHU_WEBHOOK_URL=
# Custom keyword included in every Feishu alert.
FEISHU_KEYWORD=美股
# Per-pair cooldown (ms) to avoid repeating the same OPEN alert every scan.
FEISHU_NOTIFY_COOLDOWN_MS=1800000
# Max OPEN opportunities included in one Feishu message.
FEISHU_NOTIFY_MAX_ITEMS=5
# Reject books when best bid/ask diverges from exchange ticker by more than this fraction.
ORDER_BOOK_TICKER_MAX_DEVIATION=0.02
# Conservative HIP-3 taker fee assumption per fill; adjust for the actual account tier.
HYPERLIQUID_TAKER_FEE_RATE=0.0009
# Normalize both venues' funding to this holding horizon.
CROSS_VENUE_FUNDING_HORIZON_HOURS=8
# Reject same-ticker contracts whose mid prices are not on the same scale.
CROSS_VENUE_PRICE_RATIO_MIN=0.8
CROSS_VENUE_PRICE_RATIO_MAX=1.2
# Persistent rolling spread history used by the mean-reversion model.
CROSS_VENUE_HISTORY_PATH=data/cross-venue-spread-history.json
CROSS_VENUE_HISTORY_DAYS=7
# Backfill 5m candles on first run so convergence signals do not need days to warm up.
CROSS_VENUE_HISTORY_BOOTSTRAP_HOURS=48
CROSS_VENUE_HISTORY_MIN_SAMPLES=48
CROSS_VENUE_CONVERGENCE_Z_SCORE=2
CROSS_VENUE_CONVERGENCE_PERCENTILE=0.95
CROSS_VENUE_MAX_HALF_LIFE_HOURS=24

# Web
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
